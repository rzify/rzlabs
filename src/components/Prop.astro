---
// Furniture the cats use: boxes, beds, tables, shelves (with knockable items),
// a food bowl and a scratching post. Each prop marks where a cat can perch
// (data-perch = box | bed | top | shelf) and, for shelves, which items can fall.
type Item = 'mug' | 'plant' | 'books' | 'glass' | 'pens' | 'figure' | 'duck';
interface Props {
  kind: 'box' | 'bed' | 'table' | 'shelf' | 'bowl' | 'post';
  items?: Item[];
  label?: string;
  class?: string;
  style?: string;
}
const { kind, items = [], label = 'rzlabs', class: cls = '', style } = Astro.props;
const INK = '#26211D';
---
{kind === 'box' && (
  <div class={`prop prop--box ${cls}`} style={style} data-perch="box" data-prop="box" aria-hidden="true">
    <svg viewBox="0 0 160 110">
      <polygon points="12,30 30,6 92,6 74,30" fill="#B48E62" stroke={INK} stroke-width="3" stroke-linejoin="round" />
      <polygon points="74,30 92,6 148,6 148,30" fill="#A7825A" stroke={INK} stroke-width="3" stroke-linejoin="round" />
      <rect x="12" y="30" width="136" height="76" rx="4" fill="#C9A67A" stroke={INK} stroke-width="3" />
      <rect x="66" y="30" width="28" height="76" fill="#E8D5B0" stroke={INK} stroke-width="2" />
      <text x="40" y="78" font-family="Geist Mono, monospace" font-size="11" fill={INK} text-anchor="middle">{label}</text>
      <text x="122" y="70" font-family="Geist Mono, monospace" font-size="9" fill={INK} text-anchor="middle">↑↑</text>
    </svg>
  </div>
)}
{kind === 'bed' && (
  <div class={`prop prop--bed ${cls}`} style={style} data-perch="bed" data-prop="bed" aria-hidden="true">
    <svg viewBox="0 0 180 70">
      <ellipse cx="90" cy="48" rx="84" ry="20" fill="#DDD4C6" stroke={INK} stroke-width="3" />
      <ellipse cx="90" cy="38" rx="68" ry="12" fill="#E0B98F" stroke={INK} stroke-width="3" />
      <path d="M40 38 Q90 50 140 38" fill="none" stroke={INK} stroke-width="2" opacity=".35" />
    </svg>
  </div>
)}
{kind === 'table' && (
  <div class={`prop prop--table ${cls}`} style={style} data-perch="top" data-prop="table" aria-hidden="true">
    <svg viewBox="0 0 200 110">
      <rect x="6" y="6" width="188" height="16" rx="5" fill="#8A6A4C" stroke={INK} stroke-width="3" />
      <rect x="22" y="22" width="12" height="84" rx="4" fill="#6E533B" stroke={INK} stroke-width="3" />
      <rect x="166" y="22" width="12" height="84" rx="4" fill="#6E533B" stroke={INK} stroke-width="3" />
    </svg>
  </div>
)}
{kind === 'shelf' && (
  <div class={`prop prop--shelf ${cls}`} style={style} data-perch="shelf" data-prop="shelf" aria-hidden="true">
    <div class="shelf__items">
      {items.map((it) => (
        <span class={`item item--${it}`} data-item={it} title="Click to put it back">
          {it === 'mug' && <svg viewBox="0 0 40 40"><rect x="6" y="10" width="22" height="26" rx="4" fill="#FBF8F3" stroke={INK} stroke-width="2.5"/><path d="M28 16 q8 0 8 7 t-8 7" fill="none" stroke={INK} stroke-width="2.5"/><path d="M12 6 q2 -3 0 -5 M19 6 q2 -3 0 -5" stroke={INK} stroke-width="1.5" fill="none"/></svg>}
          {it === 'plant' && <svg viewBox="0 0 40 52"><path d="M20 26 C 8 20 6 8 12 2 C 18 10 20 18 20 26 C 22 14 28 6 36 6 C 34 18 28 24 20 26" fill="#C2CB8C" stroke={INK} stroke-width="2.2"/><path d="M8 26 h24 l-3 24 h-18 z" fill="#C98B7E" stroke={INK} stroke-width="2.5" stroke-linejoin="round"/></svg>}
          {it === 'books' && <svg viewBox="0 0 44 46"><rect x="3" y="8" width="10" height="36" rx="2" fill="#707176" stroke={INK} stroke-width="2.2"/><rect x="14" y="4" width="10" height="40" rx="2" fill="#E0B98F" stroke={INK} stroke-width="2.2"/><rect x="25" y="12" width="9" height="32" rx="2" fill={INK} stroke={INK} stroke-width="2.2"/><rect x="33" y="14" width="9" height="30" rx="2" fill="#FBF8F3" stroke={INK} stroke-width="2.2" transform="rotate(8 37 44)"/></svg>}
          {it === 'glass' && <svg viewBox="0 0 30 44"><path d="M5 4 h20 l-3 36 h-14 z" fill="#DDE6EE" fill-opacity=".7" stroke={INK} stroke-width="2.5" stroke-linejoin="round"/><path d="M7 18 h16" stroke="#6F8DB5" stroke-width="10" opacity=".35"/></svg>}
          {it === 'pens' && <svg viewBox="0 0 34 48"><rect x="4" y="20" width="26" height="26" rx="4" fill="#5E4C3B" stroke={INK} stroke-width="2.5"/><rect x="9" y="4" width="4" height="18" fill="#E0B98F" stroke={INK} stroke-width="1.6"/><rect x="16" y="8" width="4" height="14" fill="#FBF8F3" stroke={INK} stroke-width="1.6"/><rect x="22" y="2" width="4" height="20" fill="#707176" stroke={INK} stroke-width="1.6"/></svg>}
          {it === 'figure' && <svg viewBox="0 0 40 44"><path d="M8 18 L9 4 L17 11 Q20 10 23 11 L31 4 L32 18 Q35 22 35 27 Q35 40 20 40 Q5 40 5 27 Q5 22 8 18 Z" fill={INK}/><rect x="13" y="20" width="4" height="10" rx="2" fill="#EAE3D8"/><rect x="23" y="20" width="4" height="10" rx="2" fill="#EAE3D8"/></svg>}
          {it === 'duck' && <svg viewBox="0 0 44 40"><ellipse cx="22" cy="28" rx="16" ry="10" fill="#E8C66A" stroke={INK} stroke-width="2.5"/><circle cx="30" cy="14" r="8" fill="#E8C66A" stroke={INK} stroke-width="2.5"/><path d="M37 14 l6 2 -6 2" fill="#C98B7E" stroke={INK} stroke-width="1.8"/><circle cx="31" cy="12" r="1.5" fill={INK}/></svg>}
        </span>
      ))}
    </div>
    <div class="shelf__plank"></div>
    <div class="shelf__brackets"><i></i><i></i></div>
  </div>
)}
{kind === 'bowl' && (
  <button type="button" class={`prop prop--bowl ${cls}`} style={style} data-prop="bowl" data-cursor="Feed" aria-label="Fill the CATS bowl">
    <svg viewBox="0 0 110 50" aria-hidden="true">
      <path d="M8 20 h94 l-10 26 h-74 z" fill="#707176" stroke={INK} stroke-width="3" stroke-linejoin="round" />
      <text x="55" y="38" font-family="Geist Mono, monospace" font-size="11" fill="#FBF8F3" text-anchor="middle">CATS</text>
      <g data-kibble opacity="0"><circle cx="36" cy="18" r="5" fill="#8A6A4C" stroke={INK} stroke-width="1.5"/><circle cx="50" cy="15" r="5" fill="#A7825A" stroke={INK} stroke-width="1.5"/><circle cx="64" cy="17" r="5" fill="#8A6A4C" stroke={INK} stroke-width="1.5"/><circle cx="76" cy="19" r="5" fill="#A7825A" stroke={INK} stroke-width="1.5"/></g>
    </svg>
  </button>
)}
{kind === 'post' && (
  <div class={`prop prop--post ${cls}`} style={style} data-perch="top" data-prop="post" aria-hidden="true">
    <svg viewBox="0 0 90 200">
      <rect x="8" y="6" width="74" height="20" rx="6" fill="#DDD4C6" stroke={INK} stroke-width="3" />
      <rect x="32" y="26" width="26" height="150" fill="#C9A67A" stroke={INK} stroke-width="3" />
      {[40, 58, 76, 94, 112, 130, 148, 166].map((y) => <path d={`M32 ${y} l26 -8`} stroke={INK} stroke-width="1.6" opacity=".5" />)}
      <rect x="4" y="176" width="82" height="20" rx="6" fill="#DDD4C6" stroke={INK} stroke-width="3" />
    </svg>
  </div>
)}
