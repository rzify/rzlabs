---
// Little looping scenes for the work cards: the cats doing something about each project.
interface Props { kind: 'obra' | 'cattleya' | 'keybind' | 'hypnotic' }
const { kind } = Astro.props;
const HEAD = 'M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z';
---
<div class={`sc sc--${kind}`} aria-hidden="true">
  {kind === 'obra' && (
    <>
      <div class="sc-obra__ground"></div>
      <div class="sc-obra__crane"><i></i></div>
      <div class="sc-obra__bld"></div>
      <div class="sc-obra__xray"><b></b><b></b><b></b></div>
      <div class="sc-obra__beam"></div>
      <div class="sc-obra__tag">RISK: LOW ✓</div>
      <div class="sc-obra__cat">
        <svg viewBox="0 0 170 120">
          <ellipse cx="80" cy="116" rx="60" ry="4" fill="#26211D" opacity=".15"/>
          <rect x="30" y="72" width="13" height="42" rx="6.5" fill="#4E3F31"/><rect x="96" y="72" width="13" height="42" rx="6.5" fill="#4E3F31"/>
          <g class="sc-obra__tail"><path d="M24 70 C 6 64 4 40 14 28" fill="none" stroke="#5E4C3B" stroke-width="10" stroke-linecap="round"/><path d="M10 40 C 9 34 11 30 14 28" fill="none" stroke="#1F1A16" stroke-width="10" stroke-linecap="round"/></g>
          <rect x="18" y="46" width="108" height="42" rx="20" fill="#5E4C3B"/>
          <rect x="44" y="46" width="8" height="18" rx="4" fill="#1F1A16"/><rect x="62" y="46" width="8" height="13" rx="4" fill="#1F1A16"/><rect x="80" y="46" width="8" height="18" rx="4" fill="#1F1A16"/><rect x="98" y="46" width="8" height="13" rx="4" fill="#1F1A16"/>
          <rect x="40" y="76" width="13" height="40" rx="6.5" fill="#5E4C3B"/><rect x="106" y="76" width="13" height="40" rx="6.5" fill="#5E4C3B"/>
          <g class="sc-obra__head"><g transform="translate(98 -2) scale(.6)">
            <path d={HEAD} fill="#5E4C3B"/><polygon points="24,30 25,19 33,26" fill="#1F1A16"/><polygon points="67,26 75,19 76,30" fill="#1F1A16"/>
            <rect x="43.5" y="32" width="3" height="12" rx="1.5" fill="#1F1A16"/><rect x="48.5" y="30" width="3" height="14" rx="1.5" fill="#1F1A16"/><rect x="53.5" y="32" width="3" height="12" rx="1.5" fill="#1F1A16"/>
            <rect x="36" y="48" width="8" height="22" rx="4" fill="#B3A25C"/><rect x="58" y="48" width="8" height="22" rx="4" fill="#B3A25C"/>
            <path d="M16 30 Q50 -4 84 30 Z" fill="#E8C66A" stroke="#26211D" stroke-width="3"/><rect x="10" y="27" width="80" height="7" rx="3" fill="#E8C66A" stroke="#26211D" stroke-width="3"/>
          </g></g>
          <g transform="translate(118 58) rotate(-12)"><rect width="26" height="34" rx="3" fill="#FBF8F3" stroke="#26211D" stroke-width="2.5"/><rect x="8" y="-3" width="10" height="6" rx="2" fill="#8A6A4C"/><path d="M5 12 h16 M5 18 h16 M5 24 h10" stroke="#26211D" stroke-width="1.6"/></g>
        </svg>
      </div>
    </>
  )}
  {kind === 'cattleya' && (
    <>
      <div class="sc-sw__sea"><i></i><i></i></div>
      <div class="sc-sw__sand"></div>
      <div class="sc-sw__sun"></div>
      <div class="sc-sw__line">
        <svg viewBox="0 0 300 120" preserveAspectRatio="none" class="sc-sw__rope"><path d="M0 10 Q150 40 300 10" fill="none" stroke="#26211D" stroke-width="2.5"/></svg>
        <div class="sc-sw__suit sc-sw__suit--a">
          <svg viewBox="0 0 60 80"><path d="M14 4 L20 4 L24 22 Q30 28 36 22 L40 4 L46 4 L48 30 Q52 44 46 58 L40 76 L20 76 L14 58 Q8 44 12 30 Z" fill="#D98BB0" stroke="#26211D" stroke-width="2.5" stroke-linejoin="round"/><circle cx="24" cy="44" r="3" fill="#F3D08A"/><circle cx="36" cy="54" r="3" fill="#F3D08A"/><circle cx="30" cy="66" r="2.5" fill="#F3D08A"/></svg>
        </div>
        <div class="sc-sw__suit sc-sw__suit--b">
          <svg viewBox="0 0 70 70"><path d="M6 6 Q18 26 32 8 M38 8 Q52 26 64 6" fill="none" stroke="#26211D" stroke-width="2"/><path d="M8 10 Q18 34 32 12 Z M38 12 Q52 34 62 10 Z" fill="#6F8DB5" stroke="#26211D" stroke-width="2.2" stroke-linejoin="round"/><path d="M14 46 L56 46 Q50 66 35 66 Q20 66 14 46 Z" fill="#6F8DB5" stroke="#26211D" stroke-width="2.2" stroke-linejoin="round"/></svg>
        </div>
      </div>
      <div class="sc-sw__parasol"><i></i></div>
      <div class="sc-sw__towel"></div>
      <div class="sc-sw__zoe">
        <svg viewBox="0 0 170 90">
          <g class="sc-cat__tail"><path d="M14 66 C 0 64 -2 48 6 40" fill="none" stroke="#707176" stroke-width="8" stroke-linecap="round"/></g>
          <rect x="12" y="44" width="118" height="34" rx="17" fill="#707176"/>
          <ellipse cx="46" cy="56" rx="12" ry="7" fill="#D4A88C"/><ellipse cx="104" cy="66" rx="7" ry="4" fill="#D4A88C"/>
          <path d="M22 50 Q30 74 44 76 L22 76 Z" fill="#D98BB0" stroke="#26211D" stroke-width="2"/>
          <path d="M92 46 Q98 62 106 46 Z M108 46 Q114 62 120 46 Z" fill="#D98BB0" stroke="#26211D" stroke-width="2" stroke-linejoin="round"/>
          <path d="M92 46 Q106 40 120 46" fill="none" stroke="#26211D" stroke-width="1.6"/>
          <circle cx="98" cy="51" r="1.6" fill="#F3D08A"/><circle cx="114" cy="51" r="1.6" fill="#F3D08A"/><circle cx="32" cy="66" r="1.8" fill="#F3D08A"/>
          <rect x="120" y="66" width="34" height="11" rx="5.5" fill="#707176"/>
          <g class="sc-sw__head"><g transform="translate(112 0) scale(.56)">
            <path d={HEAD} fill="#707176"/><ellipse cx="50" cy="31" rx="5" ry="10" fill="#D4A88C"/><ellipse cx="69" cy="37" rx="8" ry="5" fill="#D4A88C"/>
            <rect x="26" y="50" width="22" height="15" rx="6" fill="#26211D"/><rect x="54" y="50" width="22" height="15" rx="6" fill="#26211D"/><rect x="46" y="54" width="10" height="3" fill="#26211D"/>
            <polygon points="46,74 54,74 50,78" fill="#3E3F43"/>
          </g></g>
        </svg>
      </div>
    </>
  )}
  {kind === 'keybind' && (
    <>
      <div class="sc-kb__key"><span>K</span></div>
      <div class="sc-kb__blue">
        <svg viewBox="0 0 150 80">
          <path d="M22 62 C 6 64 4 50 14 44" fill="none" stroke="#E0B98F" stroke-width="7" stroke-linecap="round" class="sc-kb__tail"/>
          <g class="sc-kb__body"><rect x="14" y="34" width="112" height="42" rx="21" fill="#FBF8F3" stroke="#D3C8B8" stroke-width="2"/>
          <rect x="96" y="66" width="30" height="10" rx="5" fill="#FBF8F3" stroke="#D3C8B8" stroke-width="1.5"/></g>
          <g transform="translate(92 6) scale(.5)"><path d={HEAD} fill="#FBF8F3" stroke="#D3C8B8" stroke-width="3"/>
            <polygon points="21,26 22,12 33,21" fill="#E0B98F"/><polygon points="67,21 78,12 79,26" fill="#E0B98F"/><ellipse cx="50" cy="77" rx="11" ry="7" fill="#E0B98F"/><polygon points="46,72 54,72 50,76" fill="#C98B7E"/>
            <path d="M33 58 Q40 65 47 58 M55 58 Q62 65 69 58" fill="none" stroke="#6F8DB5" stroke-width="4" stroke-linecap="round"/></g>
        </svg>
        <span class="sc-kb__z"><b>z</b><b>z</b><b>z</b></span>
      </div>
      <div class="sc-kb__frames"><span>REC</span><span>KKKKKKKKKK…</span></div>
    </>
  )}
  {kind === 'hypnotic' && (
    <>
      <div class="sc-hy__spiral"></div>
      <div class="sc-hy__cats">
        {[['#FBF8F3', '#D3C8B8'], ['#5E4C3B', 'none'], ['#707176', 'none']].map(([fur, stroke]) => (
          <svg viewBox="0 0 100 100"><path d={HEAD} fill={fur} stroke={stroke} stroke-width="3"/>
            <g class="sc-hy__eye" style="transform-origin: 38px 60px"><circle cx="38" cy="60" r="10" fill="#FBF8F3"/><path d="M38 60 m0 -7 a7 7 0 1 1 -6 9 a4 4 0 1 1 4 -5" fill="none" stroke="#26211D" stroke-width="2.2"/></g>
            <g class="sc-hy__eye" style="transform-origin: 62px 60px"><circle cx="62" cy="60" r="10" fill="#FBF8F3"/><path d="M62 60 m0 -7 a7 7 0 1 1 -6 9 a4 4 0 1 1 4 -5" fill="none" stroke="#26211D" stroke-width="2.2"/></g>
          </svg>
        ))}
      </div>
      <div class="sc-hy__code">&lt;/&gt; front · back · everything between</div>
    </>
  )}
</div>
