---
import Base from '../layouts/Base.astro';
import PauseMark from '../components/PauseMark.astro';
import Prop from '../components/Prop.astro';
import Blue from '../components/cats/Blue.astro';
import Spooky from '../components/cats/Spooky.astro';
import Zoe from '../components/cats/Zoe.astro';
import ProjectScene from '../components/ProjectScene.astro';
import ServiceScene from '../components/ServiceScene.astro';

const projects = [
  { kind: 'obra', tag: 'Product', title: 'ObraXRAY', role: 'CTO & Co-founder', line: 'Checks Portuguese construction companies against official public records, before you sign. I built the product.', url: 'https://obraxray.com' },
  { kind: 'cattleya', tag: 'Product', title: 'TheCattleyaStudio', role: 'Co-founder', line: 'Swimwear brand. I built the tech behind it.', url: 'https://bycattleyastudio.com' },
  { kind: 'keybind', tag: 'Animation', title: 'KeybindStudios', role: 'Co-founder', line: 'Product, animation and a bit of everything else. I also built keybindstudios.com.', url: 'https://keybindstudios.com' },
  { kind: 'hypnotic', tag: 'Full stack', title: 'Hypnotic', role: 'Full stack developer', line: 'Full stack developer at Hypnotic for the past few years.', url: 'https://hypnoticagency.com' },
] as const;
const services = [
  { n: '01', name: 'Software', line: 'AI products, apps and internal tools. Lately, mostly AI.', skin: 'blue', tone: 'ink', kind: 'software' },
  { n: '02', name: 'Web', line: 'Websites with a bit of life in them, like this one. Cats optional.', skin: 'spooky', tone: 'milk', kind: 'web' },
  { n: '03', name: 'Motion', line: 'Product videos, UI animation and motion design.', skin: 'zoe', tone: 'smoke', kind: 'motion' },
  { n: '04', name: 'Animation', line: 'Characters, loops and short animated pieces.', skin: 'linen', tone: 'apricot', kind: 'animation' },
] as const;
const clips = [
  { id: 'top', label: 'Intro', tone: 'deep' },
  { id: 'work', label: 'Work', tone: 'ink' },
  { id: 'services', label: 'Services', tone: 'apricot' },
  { id: 'team', label: 'Team', tone: 'milk' },
  { id: 'contact', label: 'Contact', tone: 'smoke' },
];
// Portuguese ISO QWERTY, 60%. [legend, units, kind]. kind: k = letter key, m = modifier, c = cat keycap.
const BRAND = new Set(['r', 'z', 'l', 'a', 'b', 's']);
const rows: Array<Array<[string, number, string?]>> = [
  [['esc', 1, 'c'], ['1', 1], ['2', 1], ['3', 1], ['4', 1], ['5', 1], ['6', 1], ['7', 1], ['8', 1], ['9', 1], ['0', 1], ["'", 1], ['«', 1], ['⌫', 2, 'm']],
  [['tab', 1.5, 'm'], ...'qwertyuiop'.split('').map((k) => [k, 1] as [string, number]), ['+', 1], ['´', 1], ['yarn', 1.5, 'c']],
  [['zzz', 1.75, 'c'], ...'asdfghjkl'.split('').map((k) => [k, 1] as [string, number]), ['ç', 1], ['º', 1], ['~', 1], ['fish', 1.25, 'c']],
  [['⇧', 1.25, 'm'], ['<', 1], ...'zxcvbnm'.split('').map((k) => [k, 1] as [string, number]), [',', 1], ['.', 1], ['-', 1], ['⇧', 2.75, 'm']],
  [['ctrl', 1.25, 'm'], ['fn', 1.25, 'm'], ['⌥', 1.25, 'm'], ['⌘', 1.25, 'm'], ['space', 6.25, 'c'], ['⌘', 1.25, 'm'], ['⌥', 1.25, 'm'], ['ctrl', 1.25, 'm']],
];
const HEAD_PATH = 'M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z';
const code = [
  '<span class="c-k">const</span> team = [<span class="c-s">\'blue\'</span>, <span class="c-s">\'spooky\'</span>, <span class="c-s">\'zoe\'</span>];',
  '<span class="c-k">for</span> (<span class="c-k">const</span> cat <span class="c-k">of</span> team) review(cat);',
  '',
  'ship({ code: <span class="c-b">true</span>, motion: <span class="c-b">true</span> });',
  '<span class="c-c">// approved by 3/3 cats</span>',
];
---
<Base>
  <div class="pattern" aria-hidden="true" data-pattern></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="dim" aria-hidden="true" data-dim></div>

  <div class="intro" data-intro aria-hidden="true">
    <svg viewBox="0 0 100 100" class="intro__mark">
      <path d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z" fill="var(--rz-color-linen)" />
      <g data-intro-pause fill="var(--rz-color-ink)"><rect x="35" y="48" width="8" height="22" rx="4" /><rect x="57" y="48" width="8" height="22" rx="4" /></g>
      <g data-intro-play fill="var(--rz-color-ink)" opacity="0"><polygon points="35,48 47,59 35,70" /><polygon points="57,48 69,59 57,70" /></g>
    </svg>
  </div>

  <a href="#top" class="wordmark logo" data-cursor="Top" title="Back to top">
    <svg class="logo__mark" viewBox="0 0 100 100" aria-hidden="true">
      <path class="logo__pause" fill-rule="evenodd" d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z M35 52 a4 4 0 0 1 8 0 v14 a4 4 0 0 1 -8 0 Z M57 52 a4 4 0 0 1 8 0 v14 a4 4 0 0 1 -8 0 Z" />
      <path class="logo__play" fill-rule="evenodd" d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z M35 48 L47 59 L35 70 Z M57 48 L69 59 L57 70 Z" />
    </svg>
    <span class="logo__text">rzlabs<span class="label">code &amp; motion studio</span></span>
  </a>
  <!-- ===== SESSION CAMERA: records key moments of the visit ===== -->
  <button type="button" class="cam" data-cam data-mode="rec" data-cursor="Your tape" title="The cats are filming this visit. Click to jump to your tape.">
    <svg class="cam__body" viewBox="0 0 120 70" aria-hidden="true">
      <rect x="30" y="14" width="72" height="44" rx="10" fill="#26211D"/>
      <rect x="38" y="8" width="26" height="10" rx="4" fill="#3a322b"/>
      <path d="M30 26 L8 18 Q2 16 2 22 V50 Q2 56 8 54 L30 46 Z" fill="#3a322b"/>
      <ellipse cx="6" cy="36" rx="5" ry="15" fill="#6F8DB5" opacity=".9"/><ellipse cx="5" cy="31" rx="1.6" ry="5" fill="#fff" opacity=".6"/>
      <rect x="40" y="48" width="52" height="5" rx="2.5" fill="#3a322b"/>
      <circle class="cam__tally" cx="94" cy="21" r="4" fill="#E2462B"/>
      <path d="M58 58 v8 M50 66 h16" stroke="#26211D" stroke-width="4" stroke-linecap="round"/>
      <g transform="translate(60 36)"><path d="M-9 -2 L-8 -12 L-3 -8 Q0 -9 3 -8 L8 -12 L9 -2 Q11 1 11 4 Q11 12 0 12 Q-11 12 -11 4 Q-11 1 -9 -2 Z" fill="#EFE7DA"/><rect x="-5" y="0" width="2.4" height="6" rx="1.2" fill="#26211D"/><rect x="2.6" y="0" width="2.4" height="6" rx="1.2" fill="#26211D"/></g>
    </svg>
    <span class="cam__lcd">
      <span class="cam__row"><i class="cam__dot" aria-hidden="true"></i><b class="cam__state" data-cam-state>REC</b><span class="cam__tc" data-cam-tc>00:00:00</span></span>
      <span class="cam__row cam__row--sub"><span class="cam__take" data-cam-take>TAKE 01</span><span class="cam__n"><b data-cam-n>0</b> moments</span></span>
    </span>
  </button>

  <!-- ===== TIMELINE MENU (editing timeline: clips = sections, playhead = scroll) ===== -->
  <nav class="tl" aria-label="Sections and controls" data-perch="top" data-perch-any>
    <button type="button" class="tl__play" data-motion-toggle aria-pressed="false" aria-label="Pause animations" data-cursor="Pause">
      <PauseMark skin="linen" size={34} />
    </button>
    <div class="tl__track" data-track>
      {clips.map((c, i) => (
        <a href={`#${c.id}`} class={`clip clip--${c.tone}`} data-clip={c.id} data-key={i}>
          <span class="clip__n">{String(i).padStart(2, '0')}</span><span class="clip__name">{c.label}</span>
        </a>
      ))}
      <div class="tl__head" data-playhead aria-hidden="true">
        <svg viewBox="0 0 100 100"><path d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z" fill="var(--rz-color-ink)"/><rect x="35" y="48" width="8" height="22" rx="4" fill="var(--rz-color-linen)"/><rect x="57" y="48" width="8" height="22" rx="4" fill="var(--rz-color-linen)"/></svg>
      </div>
    </div>
    <span class="tl__tc" data-timecode aria-hidden="true">00:00:00:00</span>
    <div class="tl__tools" role="group" aria-label="Cat toys">
      <button type="button" class="tool" data-toy="yarn" aria-label="Throw a ball" data-cursor="Ball">
        <svg aria-hidden="true" viewBox="0 0 40 40"><circle cx="20" cy="20" r="17" fill="#E8893A" stroke="#26211D" stroke-width="2.5"/><circle cx="14" cy="13" r="4.5" fill="#fff" opacity=".35"/></svg>
      </button>
      <button type="button" class="tool tool--laser" data-toy="laser" aria-pressed="false" aria-label="Laser pointer" data-cursor="Laser">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect x="6" y="16" width="22" height="9" rx="4" fill="var(--rz-color-ink)"/><circle cx="33" cy="20.5" r="4" fill="#D9573B"/></svg>
      </button>
      <button type="button" class="tool" data-toy="treat" aria-label="Open a tin of pâté" data-cursor="Pâté">
        <svg aria-hidden="true" viewBox="0 0 40 40"><path d="M5 19 v9 q0 6 15 6 q15 0 15 -6 v-9" fill="#C9CDD1" stroke="#26211D" stroke-width="2.2"/><path d="M5.5 22 q14.5 5 29 0 v5 q-14.5 5 -29 0 z" fill="#E0B98F"/><ellipse cx="20" cy="19" rx="15" ry="6" fill="#B9806E" stroke="#26211D" stroke-width="2.2"/><path d="M12 18 q4 -3 8 0 q4 3 8 0" fill="none" stroke="#8A5A4C" stroke-width="1.6" stroke-linecap="round"/><circle cx="20" cy="27" r="1.6" fill="#26211D"/><circle cx="17.4" cy="25" r=".9" fill="#26211D"/><circle cx="22.6" cy="25" r=".9" fill="#26211D"/></svg>
      </button>
    </div>
    <button type="button" class="tl__btn" data-sheet-open title="Secrets found — click to see them" data-cursor="Secrets"><span class="tl__star" aria-hidden="true">★</span><span class="tl__count"><b data-secret-count>0</b>/<span data-secret-total>24</span></span><small>secrets</small></button>
  </nav>

  <!-- ===== ZOE'S WINDOW (fixed, left edge): a hammock stuck to the glass ===== -->
  <div class="zwin" data-perch="window" data-cursor="Knock" role="button" tabindex="-1" aria-label="Zoe’s spot, her window">
    <svg viewBox="0 0 170 250" aria-hidden="true">
      <defs><clipPath id="zwin-glass"><rect x="16" y="14" width="138" height="196" rx="6"/></clipPath></defs>
      <rect x="6" y="4" width="158" height="216" rx="12" class="zwin__frame"/>
      <g clip-path="url(#zwin-glass)">
        <rect x="16" y="14" width="138" height="196" class="zwin__sky"/>
        <circle cx="122" cy="52" r="14" class="zwin__sun"/>
        <g data-cloud class="zwin__cloud"><ellipse cx="50" cy="70" rx="22" ry="8"/><ellipse cx="62" cy="64" rx="14" ry="9"/></g>
        <path d="M16 170 h22 v-26 l12 -10 l12 10 v18 h18 v-34 h26 v20 l10 -8 l10 8 v-14 h28 v74 h-138 z" class="zwin__roofs"/>
        <g class="zwin__lights"><rect x="24" y="152" width="5" height="6"/><rect x="88" y="140" width="5" height="6"/><rect x="132" y="150" width="5" height="6"/><rect x="66" y="166" width="5" height="6"/></g>
        <g data-bird class="zwin__bird" opacity="0"><path d="M0 0 q6 -6 12 0 q6 -6 12 0" fill="none" stroke-width="2.4" stroke-linecap="round"/></g>
      </g>
      <rect x="83" y="14" width="4" height="196" class="zwin__bar"/>
      <rect x="16" y="104" width="138" height="4" class="zwin__bar"/>
      <rect x="0" y="212" width="170" height="14" rx="5" class="zwin__sill"/>
      <g data-hammock>
        <circle cx="30" cy="118" r="7" class="zwin__cup"/><circle cx="140" cy="118" r="7" class="zwin__cup"/>
        <path d="M30 118 L22 168 M30 118 L52 172 M140 118 L148 168 M140 118 L118 172" class="zwin__strap"/>
        <path d="M14 164 Q85 214 156 164 L158 172 Q85 226 12 172 Z" class="zwin__fabric"/>
        <path d="M34 182 Q85 206 136 182" class="zwin__stitch"/>
      </g>
    </svg>
    <span class="zwin__tag">ZOE’S SPOT</span>
  </div>

  <main>
    <!-- ===== HERO ===== -->
    <section class="scene" id="top" data-scene data-zone="linen" aria-labelledby="hero-title">
      <div class="scene__stick" data-floor>
        <!-- camera viewfinder over the whole hero -->
        <div class="vf" data-vf aria-hidden="true">
          <i class="vf__c vf__c--tl"></i><i class="vf__c vf__c--tr"></i><i class="vf__c vf__c--bl"></i><i class="vf__c vf__c--br"></i>
          <span class="vf__rec"><b></b>REC</span>
          <span class="vf__meta vf__meta--l">CAM A · 24 FPS · ISO 400</span>
          <span class="vf__meta vf__meta--r">rzlabs_reel_final_v3.mov</span>
          <i class="vf__cross"></i>
        </div>

        <Prop kind="shelf" items={['books', 'mug', 'plant']} class="hero-shelf" />

        <div class="scene__copy" data-copy>
          <p class="label scene__kicker" data-line>rzlabs — code &amp; motion studio</p>
          <h1 class="scene__title" id="hero-title" data-perch="top" data-perch-any>
            <span class="ln" data-line>Software</span>
            <span class="ln" data-line>that <span class="sel">moves.</span></span>
          </h1>
        </div>

        <div class="world" data-world>
          <div class="world__inner" data-depth="0.25">
            <div class="desk" aria-hidden="true"></div>
            <div class="mat" aria-hidden="true"></div>
            <div class="pole" aria-hidden="true"></div>

            <!-- 27" above: a round of the favourite game -->
            <div class="monitor monitor--top" data-perch="top" data-perch-any aria-hidden="true">
              <div class="cs">
                <div class="cs__sky"></div>
                <div class="cs__wall"></div>
                <div class="cs__crate cs__crate--a"></div><div class="cs__crate cs__crate--b"></div><div class="cs__crate cs__crate--c"></div>
                <div class="cs__cross"></div>
                <div class="cs__hud cs__hud--l"><b>+</b> 100 <b>◈</b> 100</div>
                <div class="cs__hud cs__hud--r">$ 800</div>
                <div class="cs__score">CT <b>7</b> : <b>5</b> T</div>
                <div class="cs__map">de_dust2</div>
              </div>
            </div>

            <!-- Ultrawide: where the code lives (the camera zooms into this one) -->
            <div class="monitor monitor--wide" data-monitor data-perch="top" data-perch-any>
              <div class="monitor__screen" data-screen>
                <div class="screen__bar" aria-hidden="true"><i></i><i></i><i></i><span>rzlabs.ts</span></div>
                <div class="screen__body">
                  <ul class="files" aria-hidden="true">
                    <li class="is-open">rzlabs.ts</li><li>cats/</li><li>habbo_room_2006.sav</li><li>metin2_lv99.cfg</li><li>de_dust2.dem</li>
                  </ul>
                  <pre class="code" data-code aria-label="Code on the monitor" set:html={code.join('\n')}></pre>
                </div>
                <div class="screen__wipe" data-screen-wipe aria-hidden="true"><span>Work.</span></div>
              </div>
              <div class="monitor__stand" aria-hidden="true"></div>
            </div>

            <Prop kind="box" class="desk-box" label="fragile" />

            <!-- a Metin stone on the desk (childhood) -->
            <div class="metin" aria-hidden="true" title="Metin stone, lv 99">
              <svg viewBox="0 0 60 80"><path d="M30 4 L50 26 L46 66 L30 76 L14 66 L10 26 Z" fill="#6F6A66" stroke="#26211D" stroke-width="3" stroke-linejoin="round"/><path d="M30 4 L30 76 M10 26 L30 36 L50 26" fill="none" stroke="#26211D" stroke-width="1.5" opacity=".4"/><path d="M22 34 l4 8 -4 8 M38 34 l-4 8 4 8 M30 46 v14" fill="none" stroke="#E2462B" stroke-width="2.4" stroke-linecap="round" class="metin__runes"/></svg>
              <span>lv 99</span>
            </div>

            <!-- MacBook, closed, in its vertical dock, with stickers -->
            <div class="macbook" aria-hidden="true">
              <div class="macbook__lid">
                <svg class="sticker sticker--cat" viewBox="0 0 100 100"><path d={HEAD_PATH} fill="#26211D"/><rect x="35" y="48" width="8" height="22" rx="4" fill="#EFE7DA"/><rect x="57" y="48" width="8" height="22" rx="4" fill="#EFE7DA"/></svg>
                <svg class="sticker sticker--room" viewBox="0 0 40 34"><path d="M2 24 V10 L20 2 V16 Z" fill="#E8C66A" stroke="#26211D" stroke-width="1.4" stroke-linejoin="round"/><path d="M20 2 L38 10 V24 L20 16 Z" fill="#F3D9A0" stroke="#26211D" stroke-width="1.4" stroke-linejoin="round"/><path d="M20 16 L38 24 L20 32 L2 24 Z" fill="#7FB5C9" stroke="#26211D" stroke-width="1.4" stroke-linejoin="round"/><path d="M17 22 l5 -2.5 4 2 -5 2.5 z" fill="#C98B7E" stroke="#26211D" stroke-width="1"/></svg>
              </div>
              <div class="macbook__dock"></div>
            </div>

            <div class="keyboard" role="group" aria-label="Keyboard: type rzlabs">
              {rows.map((row) => (
                <div class="krow">
                  {row.map(([k, u, kind]) => kind === 'c' ? (
                    <span class={`cap cap--cat cap--${k}`} style={`--u:${u}`} aria-hidden="true">
                      {k === 'esc' && <svg viewBox="0 0 100 100"><path d={HEAD_PATH} fill="currentColor"/></svg>}
                      {k === 'space' && <span class="paws">· · ·  rzlabs  · · ·</span>}
                      {k === 'yarn' && <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="13" fill="#C98B7E"/><path d="M9 15 Q20 22 31 12 M8 23 Q20 30 32 20" fill="none" stroke="#26211D" stroke-width="2"/></svg>}
                      {k === 'fish' && <svg viewBox="0 0 40 40"><path d="M6 20 Q16 8 28 20 Q16 32 6 20 Z M28 20 l8 -6 v12 z" fill="#6F8DB5"/></svg>}
                      {k === 'zzz' && <span>zzz</span>}
                    </span>
                  ) : kind === 'm' ? (
                    <span class="cap cap--mod" style={`--u:${u}`} aria-hidden="true">{k}</span>
                  ) : (
                    <button type="button" class={`cap${BRAND.has(k) ? ' cap--brand' : ''}`} style={`--u:${u}`} data-cap={k} data-cursor="Type" tabindex={BRAND.has(k) ? undefined : -1}>{k}</button>
                  ))}
                </div>
              ))}
            </div>

            <!-- mouse -->
            <div class="mouse" aria-hidden="true"><i></i></div>
          </div>
        </div>

        <div class="scene__foot" data-foot>
          <p class="scene__sub" data-line>Software, web, motion and animation. Blue, Spooky and Zoe check all of it, when they’re not knocking things off the desk.</p>
          <div class="row" data-line>
            <a href="#work" class="btn btn--ink" data-cursor="Scroll">See the work</a>
            <a href="#contact" class="btn" data-cursor="Write">Say hello</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== WORK ===== -->
    <section class="work" id="work" data-zone="ink" aria-labelledby="work-title">
      <div class="work__pin" data-work-pin data-floor>
        <div class="work__head wrap">
          <div>
            <p class="label">Spooky's desk</p>
            <h2 class="display d-xl" id="work-title" data-split data-perch="top">Selected work.</h2>
          </div>
          <div class="work__side">
            <Prop kind="box" class="work-box" label="projects" />
            <p class="work__count label"><b data-work-count>01</b> / {String(projects.length).padStart(2, '0')}</p>
          </div>
        </div>
        <div class="work__track" data-work-track>
          {projects.map((p, i) => (
            <article class="wcard" data-tilt data-cursor="Open" data-perch="top" data-perch-any>
              <div class="wcard__slate"><span>SCENE {String(i + 1).padStart(2, '0')}</span><span>TAKE {String((i * 3) % 7 + 1).padStart(2, '0')}</span><span>{p.tag.toUpperCase()}</span></div>
              <div class="wcard__media"><ProjectScene kind={p.kind} /></div>
              <div class="wcard__meta">
                <h3 class="wcard__title"><a href={p.url} target="_blank" rel="noopener">{p.title} <span aria-hidden="true">↗</span></a></h3>
                <span class="label">{p.role}</span>
              </div>
              <p class="wcard__line">{p.line}</p>
              <span class="stamp" aria-hidden="true"><svg viewBox="0 0 40 40"><ellipse cx="20" cy="26" rx="8" ry="6.5" /><circle cx="11" cy="16" r="3.4" /><circle cx="17" cy="11" r="3.4" /><circle cx="24" cy="11" r="3.4" /><circle cx="30" cy="16" r="3.4" /></svg>approved</span>
            </article>
          ))}
          <div class="wcard wcard--end">
            <p class="display d-m">Yours next?</p>
            <a href="#contact" class="btn btn--linen" data-cursor="Write">Start a project</a>
          </div>
        </div>
        <div class="work__bar wrap" aria-hidden="true"><i data-work-bar></i></div>
      </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <section class="services wrap" id="services" data-zone="linen" data-floor aria-labelledby="services-title">
      <div class="services__head">
        <div>
          <p class="label">What we do</p>
          <h2 class="display d-xl" id="services-title" data-split data-perch="top">Four things, done properly.</h2>
        </div>
        <div class="services__props" data-floor>
          <Prop kind="table" class="svc-table" />
          <Prop kind="shelf" items={['glass', 'pens', 'figure']} class="svc-shelf" />
        </div>
      </div>
      <div class="stack" data-stack>
        {services.map((s) => (
          <article class={`scard scard--${s.tone}`} data-scard data-perch="top" data-perch-any>
            <div class="scard__clap" aria-hidden="true"></div>
            <div class="scard__top">
              <span class="label">{s.n}</span>
              <PauseMark skin={s.skin} size={72} />
            </div>
            <h3 class="scard__name">{s.name}</h3>
            <p class="scard__line">{s.line}</p>
            <ServiceScene kind={s.kind} />
          </article>
        ))}
      </div>
    </section>

    <!-- ===== TEAM ===== -->
    <section class="team" id="team" data-zone="milk" data-floor aria-labelledby="team-title">
      <div class="wrap">
        <p class="label">Meet the team</p>
        <h2 class="display d-xl" id="team-title" data-split data-perch="top">One human. Three supervisors.</h2>
        <p class="team__text" role="group" data-words>rzlabs is a small studio for software, web and motion. One human writes the code and draws the frames. Three cats review everything, mostly by sitting on it.</p>
        <p class="team__note">I’m Fábio. I build software, these days mostly with AI, and I animate. I co-founded ObraXRAY (where I’m CTO), TheCattleyaStudio and KeybindStudios, and I’ve spent the last few years at Hypnotic Agency. Most days I also fit in the gym. The cats still don’t get why I leave.</p>
        <p class="team__real">The cats are real. Hover a badge and ask them.</p>
        <div class="crew">
          {[
            { id: 'blue', name: 'Blue', role: 'Head of calm', line: 'The smallest and the neediest. Pet anyone else and he comes running.', no: 'RZ-001', dept: 'Calm',
              why: 'Named after his eyes. We found him on his own in the middle of nowhere, about two months old.' },
            { id: 'spooky', name: 'Spooky', role: 'QA, from the same spot', line: 'Never moves. Give him time and he rolls over. Too much love and he turns his back.', no: 'RZ-002', dept: 'QA',
              why: 'Rescued from a place where he was being bullied. He was six when he got to us and scared of everything. He still is, a bit. Hence the name.' },
            { id: 'zoe', name: 'Zoe', role: 'Creative director (self-appointed)', line: 'Affection on her terms. Overdo it and she’s gone. Keep breakables away from her.', no: 'RZ-003', dept: 'Creative',
              why: 'The only one who came with a name. Someone left her at a door in a posh part of Porto, which explains the attitude. She was a month old.' },
          ].map((c) => (
            <div class={`badge badge--${c.id}`} data-crew={c.id} data-why={c.why} data-tilt data-perch="top" data-perch-any>
              <span class="badge__clip" aria-hidden="true"></span>
              <div class="badge__band" aria-hidden="true"><span>Crew · All access</span></div>
              <div class="badge__head"><span class="label">rzlabs productions</span><span class="badge__onset label" data-onset>Off set</span></div>
              <div class="badge__photo">
                <span class="badge__stamp" aria-hidden="true"><svg viewBox="0 0 40 40"><ellipse cx="20" cy="26" rx="8" ry="6.5"/><circle cx="11" cy="16" r="3.4"/><circle cx="17" cy="11" r="3.4"/><circle cx="24" cy="11" r="3.4"/><circle cx="30" cy="16" r="3.4"/></svg>crew</span>
                {c.id === 'blue' && <Blue />}
                {c.id === 'spooky' && <Spooky />}
                {c.id === 'zoe' && <Zoe />}
              </div>
              <h3>{c.name}</h3>
              <p class="label">{c.role}</p>
              <p class="badge__dept">Dept · {c.dept} · {c.no}</p>
              <p class="badge__line">{c.line}</p>
              <div class="badge__code" aria-hidden="true"></div>
            </div>
          ))}
        </div>
        <div class="team__room" aria-hidden="false">
          <Prop kind="bed" class="team-bed" />
          <Prop kind="bowl" class="team-bowl" />
          <Prop kind="post" class="team-post" />
          <Prop kind="box" class="team-box" label="do not sit" />
        </div>
      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section class="contact" id="contact" data-zone="ink" data-floor aria-labelledby="contact-title">
      <div class="wrap contact__grid">
        <div>
          <p class="label">Zoe's office</p>
          <h2 class="display d-hero" id="contact-title" data-split>Say hello.</h2>
          <p class="contact__lede">Write before Zoe changes her mind. The cats will take your brief.</p>
          <!-- The brief, as a chat with the cats. It writes an email you send from your own mail app. -->
          <form class="chat" data-chat data-lenis-prevent novalidate aria-label="Project brief, asked by the cats">
            <ol class="chat__log" data-chat-log aria-live="polite"></ol>
            <div class="chat__input" data-chat-input></div>
            <label class="chat__honey" aria-hidden="true">Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </form>
          <p class="contact__or">Rather skip the cats? <a class="contact__mail" href="mailto:hello@rzlabs.me" data-magnetic data-cursor="Write" data-perch="top">hello@rzlabs.me</a></p>
        </div>
        <div class="contact__props" data-floor>
          <Prop kind="shelf" items={['duck', 'mug', 'books', 'plant']} class="contact-shelf" />
          <Prop kind="bed" class="contact-bed" />
        </div>
      </div>
      <div class="bigmark" aria-hidden="true" data-bigmark>
        <div class="bigmark__peek" data-peek>
          <PauseMark skin="blue" size={120} />
          <PauseMark skin="spooky" size={120} />
          <PauseMark skin="zoe" size={120} />
        </div>
        <div class="bigmark__word" data-perch="top" data-perch-any>rzlabs</div>
      </div>
      <!-- ===== THE REEL: what the camera caught this visit ===== -->
      <div class="reel wrap" id="reel" data-reel>
        <div class="reel__head">
          <p class="label">Your cut</p>
          <p class="reel__stamp" aria-hidden="true">End of tape</p>
          <p class="reel__sum label" data-reel-sum></p>
          <button type="button" class="btn btn--linen reel__play" data-reel-play data-cursor="Play">▶ Watch your cut</button>
        </div>
        <p class="reel__intro">The cats filmed your visit. Every frame is something that happened. Click one to watch it.</p>
        <p class="reel__empty" data-reel-empty>Nothing on tape yet. Pet a cat, throw the yarn, or scroll back up and give them something to film.</p>
        <ol class="reel__strip" data-reel-strip></ol>
      </div>

      <div class="wrap foot">
        <span>© {new Date().getFullYear()} rzlabs</span>
        <span>Code &amp; motion studio · rzlabs.me</span>
        <button type="button" data-sheet-open>Press ? for shortcuts &amp; secrets</button>
      </div>
    </section>
  </main>

  <div class="fx" data-fx></div>
  <div class="cursor" data-cursor-el aria-hidden="true"><span data-cursor-label></span></div>

  <div class="player" data-player hidden role="dialog" aria-modal="true" aria-label="Your cut">
    <div class="player__box">
      <div class="player__screen" data-player-screen></div>
      <div class="player__bar">
        <button type="button" data-player-prev aria-label="Previous moment">⏮</button>
        <button type="button" data-player-play aria-label="Play">▶</button>
        <button type="button" data-player-next aria-label="Next moment">⏭</button>
        <span class="player__dots" data-player-dots></span>
        <button type="button" class="player__goto" data-player-goto>Go to the spot</button>
        <button type="button" data-player-close aria-label="Close">×</button>
      </div>
    </div>
  </div>

  <div class="polaroid" data-polaroid hidden>
    <figure class="polaroid__card" role="dialog" aria-modal="false" aria-labelledby="polaroid-name">
      <img data-polaroid-img alt="" />
      <figcaption>
        <b id="polaroid-name" data-polaroid-name></b>
        <span data-polaroid-why></span>
      </figcaption>
      <button type="button" class="polaroid__close" data-polaroid-close aria-label="Close photo">×</button>
    </figure>
  </div>

  <div class="toast" role="status" aria-live="polite" data-toast>
    <PauseMark skin="linen" />
    <span data-toast-text></span>
  </div>

  <dialog class="sheet" data-sheet data-lenis-prevent aria-labelledby="sheet-title">
    <div class="sheet__clap" aria-hidden="true"></div>
    <div class="sheet__vf" aria-hidden="true"><i class="vf__c vf__c--tl"></i><i class="vf__c vf__c--tr"></i><i class="vf__c vf__c--bl"></i><i class="vf__c vf__c--br"></i></div>
    <header class="sheet__head">
      <div>
        <p class="label"><b class="sheet__rec"></b> Call sheet · the cats are keeping score</p>
        <h2 id="sheet-title">Secrets</h2>
      </div>
      <div class="sheet__peeks" aria-hidden="true"><svg class="peek peek--blue" viewBox="0 0 100 100" data-peek-cat="blue"><path d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z" fill="#FBF8F3" stroke="#D3C8B8" stroke-width="3"/><g class="peek__eyes"><rect x="36" y="48" width="8" height="22" rx="4" fill="#6F8DB5"/><rect x="58" y="48" width="8" height="22" rx="4" fill="#6F8DB5"/></g></svg><svg class="peek peek--spooky" viewBox="0 0 100 100" data-peek-cat="spooky"><path d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z" fill="#5E4C3B" /><g class="peek__eyes"><rect x="36" y="48" width="8" height="22" rx="4" fill="#B3A25C"/><rect x="58" y="48" width="8" height="22" rx="4" fill="#B3A25C"/></g></svg><svg class="peek peek--zoe" viewBox="0 0 100 100" data-peek-cat="zoe"><path d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z" fill="#707176" /><g class="peek__eyes"><rect x="36" y="48" width="8" height="22" rx="4" fill="#C2CB8C"/><rect x="58" y="48" width="8" height="22" rx="4" fill="#C2CB8C"/></g></svg></div>
      <form method="dialog"><button class="sheet__x" aria-label="Close">×</button></form>
    </header>
    <div class="sheet__progress">
      <span><b data-secret-count>0</b> of <span data-secret-total>25</span> found</span>
      <i class="sheet__track"><b data-secret-bar></b><span class="walker" data-walker aria-hidden="true"><svg viewBox="0 0 100 100"><path d="M20 40 L22 12 L42 28 Q50 26 58 28 L78 12 L80 40 Q86 49 86 58 Q86 88 50 88 Q14 88 14 58 Q14 49 20 40 Z" fill="currentColor"/><rect x="35" y="48" width="8" height="22" rx="4" fill="#1d1916"/><rect x="57" y="48" width="8" height="22" rx="4" fill="#1d1916"/></svg></span></i>
    </div>
    <div class="sheet__filters" role="group" aria-label="Filter secrets">
      <button type="button" class="is-on" data-filter="all">All</button><button type="button" data-filter="blue">Blue</button><button type="button" data-filter="spooky">Spooky</button><button type="button" data-filter="zoe">Zoe</button><button type="button" data-filter="you">You</button><button type="button" data-filter="locked">Still locked</button>
    </div>
    <ul class="secrets" data-secret-list></ul>
    <div class="sheet__keys">
      <span><kbd>P</kbd> pause</span><span><kbd>←</kbd><kbd>→</kbd> sections</span><span><kbd>X</kbd> laser</span><span><kbd>?</kbd> this sheet</span>
    </div>
  </dialog>

  <script>
    import '../scripts/main.ts';
  </script>
</Base>
