# Copy to .env (local) and add the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
RESEND_API_KEY=
# Where briefs arrive (comma-separated for more than one)
BRIEF_TO=
# Sender. Use your verified domain once rzlabs.me is verified in Resend, e.g. "rzlabs <hello@rzlabs.me>"
BRIEF_FROM=rzlabs <onboarding@resend.dev>
# Cloudflare Turnstile (free). The site key is public, the secret stays on the server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
